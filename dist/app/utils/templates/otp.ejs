<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>OTP Verification</title>
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #f9f9f9;
      margin: 0;
      padding: 0;
      color: #333;
    }

    .container {
      max-width: 500px;
      margin: 30px auto;
      background: #ffffff;
      border-radius: 12px;
      box-shadow: 0 6px 15px rgba(0,0,0,0.1);
      overflow: hidden;
    }

    .header {
      background: #2563eb; /* blue-600 */
      color: #fff;
      text-align: center;
      padding: 20px;
    }

    .header h1 {
      margin: 0;
      font-size: 22px;
    }

    .content {
      padding: 25px;
      text-align: center;
    }

    .otp-box {
      display: inline-block;
      background: #f1f5f9;
      color: #111;
      font-size: 28px;
      letter-spacing: 8px;
      padding: 15px 20px;
      border-radius: 8px;
      font-weight: bold;
      margin: 20px 0;
    }

    .info {
      font-size: 15px;
      line-height: 1.6;
      color: #555;
    }

    .footer {
      margin-top: 25px;
      font-size: 13px;
      color: #999;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>OTP Verification</h1>
    </div>
    <div class="content">
      <p class="info">Hello <%= name %>,</p>
      <p class="info">Please use the following One-Time Password (OTP) to complete your verification. The OTP will expire in <%= expiry %> seconds.</p>
    
      <div class="otp-box">
        <%= otp %>
      </div>

      <p class="info">If you did not request this, you can safely ignore this email.</p>

      <div class="footer">
        <p>© <%= new Date().getFullYear() %> Your Company. All rights reserved.</p>
      </div>
    </div>
  </div>
</body>
</html>